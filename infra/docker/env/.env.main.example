# Main production environment template
# Copy to env/.env.main and set real values from your secret manager.
# Never commit real production secrets.

# External database endpoints (production DNS/IP)
MONGO_HOST=mongodb.prod.internal
POSTGRESQL_HOST=postgresql.prod.internal

# MongoDB external credentials
MONGO_DB_USERNAME=change_me_prod_mongo_user
MONGO_DB_PASSWORD=change_me_prod_mongo_password
MONGO_DB_PORT=27017

# PostgreSQL external credentials
POSTGRESQL_DB_USERNAME=change_me_prod_pg_user
POSTGRESQL_DB_PASSWORD=change_me_prod_pg_password
POSTGRESQL_DB_PORT=5432

CONFIG_SERVER_HOST=config-server
EUREKA_SERVER_HOST=discovery-server
CONFIG_SERVER_PORT=38888
EUREKA_SERVER_PORT=38761

CUSTOMER_DB_NAME=customer_db_prod
CUSTOMER_MICROSERVICE_PORT=38091

PRODUCT_DB_NAME=product_db_prod
PRODUCT_MICROSERVICE_PORT=38092

CART_DB_NAME=cart_db_prod
CART_MICROSERVICE_PORT=38093

