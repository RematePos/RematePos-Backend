# Dev environment template
# Copy to env/.env.dev and replace placeholder values for your machine.
MONGO_HOST=mongodb
POSTGRESQL_HOST=host.docker.internal
DATABASE_NETWORK_NAME=pos-db-dev_default

MONGO_DB_USERNAME=admin
MONGO_DB_PASSWORD=example_mongo_password
MONGO_DB_PORT=27017
POSTGRESQL_DB_USERNAME=postgres
POSTGRESQL_DB_PASSWORD=example_postgres_password
POSTGRESQL_DB_PORT=5433

CONFIG_SERVER_PORT=8888
EUREKA_SERVER_PORT=8761
API_GATEWAY_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

CUSTOMER_DB_NAME=customer_db
CUSTOMER_MICROSERVICE_PORT=8091

PRODUCT_DB_NAME=product_db
PRODUCT_MICROSERVICE_PORT=8092

CART_DB_NAME=cart_db
CART_MICROSERVICE_PORT=8093

AUTH_DB_NAME=auth_db
AUTH_MICROSERVICE_PORT=8096
JWT_SECRET=change_me_use_secret_store
JWT_EXPIRATION_MS=3600000
INTERNAL_SERVICE_TOKEN=change_me_use_secret_store
AUTH_DEMO_REGISTRATION_ENABLED=false
AUTH_SEED_DEMO_USERS=false
AUTH_DEMO_ADMIN_PASSWORD=change_me_admin_demo_password
AUTH_DEMO_CASHIER_PASSWORD=change_me_cashier_demo_password

PURCHASE_DB_NAME=purchase_db
PURCHASE_MICROSERVICE_PORT=8094

INVOICE_DB_NAME=invoice_db
INVOICE_MICROSERVICE_PORT=8095
BILLING_PROVIDER=MOCK_DIAN
BILLING_ENVIRONMENT=DEMO
BILLING_DEMO_LEGEND=Documento generado en ambiente de demostración, sin validez tributaria.
FACTUS_API_BASE_URL=
FACTUS_API_KEY=
FACTUS_CLIENT_ID=
FACTUS_CLIENT_SECRET=
