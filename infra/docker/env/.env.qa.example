# QA environment template
# Copy to env/.env.qa and replace placeholder values.
MONGO_HOST=host.docker.internal
POSTGRESQL_HOST=host.docker.internal

MONGO_DB_USERNAME=qa_user
MONGO_DB_PASSWORD=change_me_qa_mongo
MONGO_DB_PORT=37017

POSTGRESQL_DB_USERNAME=qa_user
POSTGRESQL_DB_PASSWORD=change_me_qa_postgres
POSTGRESQL_DB_PORT=6433
JPA_DDL_AUTO=validate
LIQUIBASE_ENABLED=true

CONFIG_SERVER_HOST=config-server
EUREKA_SERVER_HOST=discovery-server
CONFIG_SERVER_PORT=18888
EUREKA_SERVER_PORT=18761

CUSTOMER_DB_NAME=customer_db_qa
CUSTOMER_MICROSERVICE_PORT=18091

PRODUCT_DB_NAME=product_db_qa
PRODUCT_MICROSERVICE_PORT=18092

CART_DB_NAME=cart_db_qa
CART_MICROSERVICE_PORT=18093

AUTH_DB_NAME=auth_db_qa
AUTH_MICROSERVICE_PORT=18096
JWT_SECRET=change_me_use_secret_store
JWT_EXPIRATION_MS=3600000
INTERNAL_SERVICE_TOKEN=change_me_use_secret_store
AUTH_DEMO_REGISTRATION_ENABLED=false
AUTH_SEED_DEMO_USERS=false
AUTH_DEMO_ADMIN_PASSWORD=change_me_admin_demo_password
AUTH_DEMO_CASHIER_PASSWORD=change_me_cashier_demo_password
AUTH_SEED_PLATFORM_ADMIN=false
AUTH_PLATFORM_ADMIN_USERNAME=platform.admin
AUTH_PLATFORM_ADMIN_PASSWORD=change_me_use_secret_store
AUTH_PLATFORM_ADMIN_EMAIL=platform.admin@example.com

BILLING_PROVIDER=MOCK_DIAN
BILLING_PROVIDER_BASE_URL=https://sandbox-api.example.com/e-provider/co/v1
BILLING_PROVIDER_USERNAME=example@example.com
BILLING_PROVIDER_TOKEN=
BILLING_PROVIDER_TIMEOUT_MS=10000
BILLING_SETTINGS_ENCRYPTION_KEY=
BILLING_ENVIRONMENT=DEMO
BILLING_DEMO_LEGEND=Documento generado en ambiente de demostración, sin validez tributaria.
FACTUS_API_BASE_URL=
FACTUS_API_KEY=
FACTUS_CLIENT_ID=
FACTUS_CLIENT_SECRET=
ANALYTICS_PORT=8090
ANALYTICS_MODE=DEMO
SERVICES_ANALYTICS_URL=http://analytics-service:8090
ANALYTICS_DATABASE_URL=
